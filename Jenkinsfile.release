@Library('nodejs') _

pipeline {
  agent { label 'JBS-NodeJS' }

  options {
    buildDiscarder(logRotator(artifactDaysToKeepStr: '30', daysToKeepStr: '30', numToKeepStr: '5'))
    ansiColor('xterm')
  }

  parameters {
    choice(
      name: 'BUMP',
      choices: ['major', 'minor', 'patch', 'premajor', 'preminor', 'prepatch', 'prerelease'],
      description: 'Version bump applied to all publishable packages in lockstep (bumpp).'
    )
    string(
      name: 'PREID',
      defaultValue: 'beta',
      description: 'Prerelease identifier, used only by the pre* bump types (e.g. 1.0.0-beta.0).'
    )
    booleanParam(
      name: 'DOCS_ONLY',
      defaultValue: false,
      description: 'Skip versioning and npm publish; build and deploy contourjs.com with its documentation.'
    )
    booleanParam(
      name: 'DRY_RUN',
      defaultValue: false,
      description: 'No version commit, npm publish --dry-run, no site deploy, no git push.'
    )
  }

  environment {
    GIT_CREDENTIALS_ID = 'dd9216fb-464b-49d9-b6ba-778a68af4f91'
  }

  stages {
    stage('Checkout') {
      steps {
        git branch: "${refName()}", url: "https://github.com/ardinsys/contour.git", credentialsId: "${GIT_CREDENTIALS_ID}"
      }
    }

    stage('Install') {
      steps {
        nsh('pnpm install --frozen-lockfile')
      }
    }

    stage('Version Packages') {
      when {
        expression { !params.DOCS_ONLY && !params.DRY_RUN }
      }
      steps {
        script {
          sh '''
            git config user.name "jenkins"
            git config user.email "dev@ardinsys.eu"
          '''

          echo "📦 Running versioning for packages"
          nsh("pnpm --dir packages/core exec bumpp package.json ../vue/package.json ../react/package.json --no-push --yes --no-print-commits --commit \"chore: release v\" --release ${params.BUMP} --preid ${params.PREID}")
        }
      }
    }

    stage('Build') {
      steps {
        script {
          nsh('''
            pnpm build
            pnpm docs:build
            NUXT_APP_BASE_URL=/ pnpm --filter @ardinsys/contour-showcase generate
            mkdir -p apps/showcase/.output/public/docs
            cp -R apps/docs/.vitepress/dist/. apps/showcase/.output/public/docs/
          ''')
        }
      }
    }

    stage('Verify') {
      when {
        expression { !params.DOCS_ONLY }
      }
      steps {
        script {
          nsh('''
            pnpm typecheck
            pnpm test
          ''')
        }
      }
    }

    stage('Publish') {
      when {
        expression { !params.DOCS_ONLY }
      }
      steps {
        script {
          def dryRunFlag = params.DRY_RUN ? '--dry-run' : ''
          // Prereleases must not become the npm "latest" dist-tag.
          def distTag = params.BUMP.startsWith('pre') ? "--tag ${params.PREID}" : ''
          nsh("pnpm -r --filter './packages/**' publish --no-git-checks ${distTag} ${dryRunFlag}")
        }

      }
    }

    stage('Publish site') {
      when {
        expression { !params.DRY_RUN }
      }
      steps {
        sshPublisher(
          publishers: [
            sshPublisherDesc(
              configName: 'contourjs.com',
              transfers: [
                sshTransfer(
                  cleanRemote: true,
                  execTimeout: 120000,
                  makeEmptyDirs: true,
                  noDefaultExcludes: true,
                  remoteDirectory: '.',
                  removePrefix: 'apps/showcase/.output/public',
                  sourceFiles: 'apps/showcase/.output/public/**'
                )
              ]
            )
          ]
        )
      }
    }

    stage('Push Changes') {
      when {
        expression { !params.DOCS_ONLY && !params.DRY_RUN }
      }
      steps {
        withCredentials([usernamePassword(credentialsId: "${GIT_CREDENTIALS_ID}", usernameVariable: 'GIT_USER', passwordVariable: 'GIT_PASS')]) {
          sh '''
            git remote set-url origin https://${GIT_USER}:${GIT_PASS}@github.com/ardinsys/contour.git
            git push origin HEAD --follow-tags
          '''
        }
      }
    }
  }

  post {
    cleanup {
      cleanWs()
    }
  }
}
